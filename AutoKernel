		echo enter path to linux source certificates: ex. /usr/src/linux-source-$VeRSioN/debian/*
		read CeRTiFiCaTeS
		rsync -axHAX $CeRTiFiCaTeS debian
		mkdir ../certificates
		rsync -axHAX $CeRTiFiCaTeS ../certificates/debian
		echo print number of cpu cores to utilize for compiling, and press enter...
		read CPN
		echo cleaning build environment:
		make clean
		echo 'Beginning main build Process...(stage 1)'
		make -j $CPN
		echo 'was there an error, if so stop script to debug, else, continue...(stage 2)'
		make modules
		echo Utilizing INSTALL_MOD_STRIP=1 flag because better alternate process not located.
		make INSTALL_MOD_STRIP=1 modules_install
		echo installing kernel...
		make install
		echo "to do: file cleanup(optional)"
		########################################################################################
		# to build into a deb for use on multiple systems or later reuse:                      #
		# make -kpkg clean                                                                     #
		# fakeroot make-mpkg --initrd --append-to-version=-custom kernel_image kernel_headers  #
		# make modules                                                                         #
		# make modules_install                                                                 #
		########################################################################################
		read -p "Full automation sequence placeholder. Press enter..." # (Can be expanded to call individual routines back-to-back)
		;;
	14)
		echo "Spawning root shell via su..."
		su
		;;
	16)
		echo "/Dev/Kernel/:"
		ls /Dev/Kernel
		echo "/Dev/Kernel/linux-$VeRSioN/:"
		ls /Dev/Kernel/linux-$VeRSioN
		read -p "Press enter to return to main menu..."
		;;
	17)
		echo "1/3"
		echo "Specify Device: ex. '/dev/sda'"
		read devxx
		echo "2/3"
		grub-install $devxx
		echo "3/3"
		update-grub
		;;
	18)
		echo "18" #debootstrap list versions
		echo "specify direcory to install debootstrap to: ex. /Dev/osTemple/customdistro"
		read dbsdir
		mkdir -p $dbsdir
		ls $dbsdir
		cd $dbsdir
		cd .. #url
		echo "use debootstrap command & manpages, etc.(optional)"
		su 
		echo "add full mounts(dev,pts,sys,proc) fstab for host system[+cp resolv,hosts] 4 boot? [y/n]"
		read fstadd
		if [ "$fstadd" = "y" ]; then
			echo "dev $dbsdir/dev dev defaults 0 0" >> /etc/fstab
			echo "dev/pts $dbsdir/dev/pts pts defaults 0 0" >> /etc/fstab
			echo "sys $dbsdir/sys sys defaults 0 0" >> /etc/fstab
			echo "proc $dbsdir/proc proc defaults 0 0" >> /etc/fstab
			cp /etc/resolv.conf $fstadd/resolv.conf 
			cp /etc/hosts $fstadd/etc/hosts
		else
			echo ""
		fi
		echo "press any key to return to main menu..."

		;;
	19|20)
		echo "$option placeholder."
		read -p "Press enter..."
		;;
	21|22|23)
		echo "Option $option placeholder."
		read -p "Press enter to continue..."
