			read -r VeRSioN
		fi
		cd linux-$VeRSioN || exit
		echo "(0) Auto batch mode or (1) Test and sequence mode?"
		read -r typez
		if [ "$typez" = "0" ]; then
			if xzcat ../patch-$VeRSioN.xz | patch -p1 --dry-run --silent >/Dev/Kernel/$VeRSioN-patch.test 2>&1; then
				echo "Dry run successfully attempted. Applying patch normally..."
				xzcat ../patch-$VeRSioN.xz | patch -p1
			else
				echo "Applying patch safely using batch mode..."
				xzcat ../patch-$VeRSioN.xz | patch -p1 --batch
			fi
		else
			echo "Testing patch files..."
			mv /Dev/Kernel/$VeRSioN-patch.test /Dev/Kernel/$VeRSioN-patch-old.test
			xzcat ../patch-$VeRSioN.xz > /Dev/Kernel/temp_extracted.patch
			grep "^\+\+\+" /Dev/Kernel/temp_extracted.patch | while read -r line; do
				filepath=$(echo "$line" | awk '{print $2}' | sed 's|^[ab]/||')
				if [ -n "$filepath" ]; then
					if patch -p1 --dry-run --silent --forward --fuzz=0 -p1 < /Dev/Kernel/tmp_extracted.patch >/dev/null 2>&1; then
						echo "$filepath: y" >> /Dev/Kernel/$VeRSioN-patch.test
					else
						if patch -p1 --dry-run --silent --reverse --fuzz=0 -p1 < /Dev/Kernel/temp_extracted.patch > /dev/null 2>&1; then
							echo "$filepath: R" >> /Dev/Kernel/$VeRSioN-patch.test
						else
							echo "$filepath: n" >> /Dev/Kernel/$VeRSioN-patch.test
						fi
					fi
				fi
			done
			cat /Dev/Kernel/$VeRSioN-patch.test
			while IFS=': ' read -r file decision; do
				if [ "$decision" = "y" ]; then
					patch -p1 --forward < /Dev/Kernel/temp_extracted.patch
				elif [ "$decision" = "R" ]; then
					patch -p1 --reverse --batch < /Dev/Kernel/temp_extracted.patch
				fi
			done < /Dev/Kernel/$VeRSioN=patch.test
			mv /Dev/Kernel/temp_extracted.patch /Dev/Kernel/temp_extracted-used.patch
		fi
		cd /Dev/Kernel || exit
		read -p "Press enter to return to main menu..."
		;;
