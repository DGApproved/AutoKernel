		apt install linux-source -y
		echo -n "Enter path to linux source certificates (ex: /usr/src/linux-source-$VeRSioN/debian/*): "
		read -r CeRTiFiCaTeS
		rsync -axHAX $CeRTiFiCaTeS debian
		mkdir -p ../certificates
		rsync -axHAX $CeRTiFiCaTeS ../certificates/debian
		cd /Dev/Kernel || exit
		read -p "Press enter to return to main menu..."
		;;
	6)
		cd /Dev/Kernel/linux-$VeRSioN 2>/dev/null || cd linux-$VeRSioN || { echo "Extract source first!"; read -p "Press enter..."; continue; }
		echo -n "Enter full path to kernel .config file (ex: /boot/config-$(uname -r)): "
		read -r SRCCoNFiG
		rsync -axHAX "$SRCCoNFiG" .config
		mkdir -p ../srcconfig
		rsync -axHAX "$SRCCoNFiG" ../srcconfig/.config
		cd /Dev/Kernel || exit
		read -p "Press enter to continue..."
		;;
	7)
		cd /Dev/Kernel/linux-$VeRSioN 2>/dev/null || cd linux-$VeRSioN || { echo "Extract source first!"; read -p "Press enter..."; continue; }
