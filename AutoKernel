download_with_check() 
{
	local url="$1"
	local filename="$2"
	if [ -f "$filename" ]; then
		echo "File '$filename' already exists."
		echo -n "Do you want to re-download/overwrite it? (y/n): "
		read choice
		case "$choice" in
		y|Y )
			echo "Re-downloading $filename..."
			wget -O "filename" "$url"
			;;
		  * )
		    echo "skipping download for $filename."
		    ;;
		esac
	else
		echo "Downloading: $url"
		wget "$url"
	fi
}
echo Script for automating Kernel Making utilities, intention for personal use only.
